# FlipMD 릴리즈 환경변수 템플릿
#
# 사용법:
#   1. 이 파일을 프로젝트 루트의 .env.release로 복사 (force add 안 됨, gitignore됨)
#   2. 값 채우기 — 특히 TAURI_SIGNING_PRIVATE_KEY 경로 확인
#
#   cp scripts/.env.release.example .env.release
#

# Apple 코드 서명 (tauri.conf.json의 macOS.signingIdentity와 일치)
export APPLE_SIGNING_IDENTITY="Developer ID Application: YONGSUB LEE (XU8HS9JUTS)"

# Apple notarization (선택 — 활성화하면 "확인되지 않은 개발자" 경고 제거)
# export APPLE_ID="your-apple-id@example.com"
# export APPLE_PASSWORD="app-specific-password"
# export APPLE_TEAM_ID="XU8HS9JUTS"

# Tauri Updater 서명 — 키 내용을 cat으로 가져옴 (파일 경로가 아닌 내용 자체가 환경변수에 들어감)
export TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/flipmd.key)

# 키 비밀번호. 키 생성 시 --ci 옵션이면 빈 문자열 유지
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# GitHub Release 대상 repo
export GITHUB_RELEASE_REPO="leonardo204/flipbookMaker"
