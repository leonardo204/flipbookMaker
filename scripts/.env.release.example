# FlipMD 릴리즈 환경변수
#
# 사용법:
#   1. 이 파일을 프로젝트 루트의 .env.release로 복사
#   2. 값 채우기
#   3. .gitignore에 .env.release 포함되어 있는지 확인 (커밋 금지)
#
#   cp scripts/.env.release.example .env.release
#

# ─── Tauri Updater 서명 ───
# minisign private key 파일의 절대 경로 (생성: npx @tauri-apps/cli signer generate -w ~/.tauri/flipmd.key)
TAURI_SIGNING_PRIVATE_KEY="$HOME/.tauri/flipmd.key"

# 키 비밀번호. 키 생성 시 --ci 옵션으로 비밀번호 없이 만들었으면 비워둠
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# ─── macOS 코드 서명 (선택 — 없어도 빌드 가능, 단 Gatekeeper 경고 노출) ───
# Apple Developer ID Application 인증서. tauri.conf.json의 macOS.signingIdentity와 일치해야 함
APPLE_SIGNING_IDENTITY="Developer ID Application: YONGSUB LEE (XU8HS9JUTS)"

# Apple notarization (선택)
# APPLE_ID="your-apple-id@example.com"
# APPLE_PASSWORD="app-specific-password"
# APPLE_TEAM_ID="XU8HS9JUTS"

# ─── GitHub Release ───
# Release 업로드 대상 저장소 (기본값: leonardo204/flipbookMaker)
# GITHUB_RELEASE_REPO="leonardo204/flipbookMaker"
