{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlipbookMaker default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:default",
    "dialog:default",
    "fs:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
