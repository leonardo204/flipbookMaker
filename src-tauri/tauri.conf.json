{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlipMD",
  "version": "1.3.1",
  "identifier": "com.altimedia.flipbookmaker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlipMD",
        "width": 1000,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 900,
        "maxWidth": 1000,
        "maxHeight": 900,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "resources": ["../scripts/crawl.mjs", "../scripts/lib"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: YONGSUB LEE (XU8HS9JUTS)",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMDgwMDk5NjY2ODAyQzkKUldUSkFtaG1tUUFJalhXbG1JQmhuU0l1Z2FHSFFMT3NHcndzRklDU2ljWjhkMzBmQmVUUUdnMXIK",
      "endpoints": [
        "https://github.com/leonardo204/flipbookMaker/releases/latest/download/latest.json"
      ]
    }
  }
}
